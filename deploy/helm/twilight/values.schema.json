{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "kind", "model"],
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["openai", "openai-responses", "anthropic", "google", "copilot"] },
          "model": { "type": "string", "minLength": 1 },
          "baseURL": { "type": "string", "pattern": "^https?://" },
          "apiKeySecret": { "type": "string", "minLength": 1 },
          "authTokenSecret": { "type": "string", "minLength": 1 }
        },
        "oneOf": [
          { "required": ["apiKeySecret"], "not": { "required": ["authTokenSecret"] } },
          { "required": ["authTokenSecret"], "not": { "required": ["apiKeySecret"] } }
        ]
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scrapeAnnotations"],
      "properties": {
        "scrapeAnnotations": {
          "type": "boolean",
          "description": "Add prometheus.io scrape annotations to the four service pods. Requires an annotation-aware scraper."
        }
      }
    },
    "podMonitor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "labels", "interval", "scrapeTimeout"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Render a PodMonitor; requires the Prometheus Operator CRD when deploying."
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Labels used by the existing Prometheus podMonitorSelector, for example release: monitoring."
        },
        "interval": {
          "type": "string",
          "pattern": "^([0-9]+(ms|s|m|h))+$"
        },
        "scrapeTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(ms|s|m|h))+$"
        }
      }
    },
    "agentSandbox": {
      "type": "object",
      "properties": {
        "snapshotAfterTurn": {
          "type": "boolean",
          "description": "Whether the owner snapshots the workspace after each turn. Keep false for Agent Sandbox, which does not support snapshots."
        }
      }
    },
    "recovery": {
      "type": "object",
      "required": ["missingEffects", "maxRedispatches", "redispatchRetry", "orphanProbe"],
      "properties": {
        "missingEffects": {
          "type": "string",
          "enum": ["dispose", "redispatch"],
          "description": "How takeover handles an executing effect missing from the executor. Redispatch may repeat external side effects."
        },
        "maxRedispatches": {
          "type": "integer",
          "minimum": 0
        },
        "redispatchRetry": {
          "type": "string",
          "minLength": 1
        },
        "orphanProbe": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "services": {
      "type": "object",
      "properties": {
        "modelBackend": {
          "type": "object",
          "properties": {
            "replicas": {
              "type": "integer",
              "enum": [1],
              "description": "model-backend uses process-local state and must run exactly one replica."
            },
            "providerSecret": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
              "description": "Optional separate Secret containing REAL_MODEL_API_KEY, mounted only by model-backend."
            }
          }
        },
        "toolBackend": {
          "type": "object",
          "properties": {
            "replicas": {
              "type": "integer",
              "enum": [1],
              "description": "tool-backend owns process-local environment handles and must run exactly one replica."
            }
          }
        }
      }
    }
  }
}
