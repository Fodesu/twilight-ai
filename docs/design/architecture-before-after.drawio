<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-08-29T12:00:00.000Z" agent="twilight-ai" version="24.0.0">
  <diagram id="before" name="旧设计：SDK 内存 loop">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ======== 泳道:Memoh 进程 ======== -->
        <mxCell id="lane-memoh" value="Memoh 进程（NativeAgentLoop，internal/agent/runtime/native/，10,890 行）" style="swimlane;horizontal=1;startSize=30;fillColor=#FFF7E6;strokeColor=#B8860B;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="620" height="560" as="geometry" />
        </mxCell>

        <mxCell id="b-orch" value="编排层&#10;prompt / context / attachment 组装" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8860B;fontSize=12;" vertex="1" parent="lane-memoh">
          <mxGeometry x="30" y="50" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="b-callbacks" value="回调织入层（47 处）&#10;wrapPrepareStepWithModelHook&#10;OnStep / OnStepCommitted 包装&#10;toolExecutionMetadata.wrap(ApprovalHandler)" style="rounded=1;whiteSpace=wrap;fillColor=#FFE4E1;strokeColor=#CC0000;fontSize=12;" vertex="1" parent="lane-memoh">
          <mxGeometry x="30" y="140" width="260" height="100" as="geometry" />
        </mxCell>

        <mxCell id="b-capture" value="逆向状态捕获（补偿设计）&#10;stepMessageCapture：截 PrepareStep 增量&#10;interruptedStepCapture：手工捕获流文本/reasoning&#10;annotateDeferredApproval：把审批塞进消息" style="rounded=1;whiteSpace=wrap;fillColor=#FFE4E1;strokeColor=#CC0000;fontSize=12;" vertex="1" parent="lane-memoh">
          <mxGeometry x="30" y="270" width="260" height="110" as="geometry" />
        </mxCell>

        <mxCell id="b-approval-flow" value="审批第二控制流&#10;waiting_decision 状态 + tool_approval_requests 表&#10;恢复 = 带注解消息重新进入新的 GenerateText" style="rounded=1;whiteSpace=wrap;fillColor=#FFE4E1;strokeColor=#CC0000;fontSize=12;" vertex="1" parent="lane-memoh">
          <mxGeometry x="30" y="410" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="b-loop" value="twilight-ai SDK：GenerateText / StreamText&#10;（内存 for 循环）&#10;&#10;for step := 0; step &lt; MaxSteps(-1=∞); step++ {&#10;&#160;&#160;PrepareStep(params)  ← 回调改参&#10;&#160;&#160;provider 调用&#10;&#160;&#160;工具执行 + ApprovalHandler ← 回调阻塞&#10;&#160;&#160;OnStep / OnStepCommitted ← 回调双写&#10;}&#10;&#10;★ 权威状态 = 本进程栈帧和局部变量&#10;★ DeferredToolApproval：单指针槽位" style="rounded=1;whiteSpace=wrap;fillColor=#FFD6D6;strokeColor=#CC0000;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="lane-memoh">
          <mxGeometry x="330" y="80" width="260" height="290" as="geometry" />
        </mxCell>

        <mxCell id="b-provider" value="Provider（Anthropic / OpenAI / ...）" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;" vertex="1" parent="lane-memoh">
          <mxGeometry x="330" y="410" width="260" height="50" as="geometry" />
        </mxCell>

        <!-- ======== 泳道:PostgreSQL ======== -->
        <mxCell id="lane-db" value="PostgreSQL（回调时机的副本，非权威）" style="swimlane;horizontal=1;startSize=30;fillColor=#F0F4FF;strokeColor=#4169AA;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="40" width="380" height="560" as="geometry" />
        </mxCell>

        <mxCell id="b-runs" value="session_runs（0121）&#10;state ∈ accepted/running/waiting_decision/...&#10;注释原文：&quot;deliberately no mid-run&#10;checkpoint column&quot; —— 步内进度无处可放" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4169AA;fontSize=12;" vertex="1" parent="lane-db">
          <mxGeometry x="40" y="60" width="300" height="90" as="geometry" />
        </mxCell>

        <mxCell id="b-approvals" value="tool_approval_requests（0073）&#10;UNIQUE (session_id, tool_call_id)&#10;审批记录 = 循环执行位置的手工序列化" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4169AA;fontSize=12;" vertex="1" parent="lane-db">
          <mxGeometry x="40" y="190" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b-history" value="bot_history_messages&#10;由 OnStepCommitted 回调整步双写&#10;与任何已提交事实无 identity 对应" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4169AA;fontSize=12;" vertex="1" parent="lane-db">
          <mxGeometry x="40" y="310" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b-crash" value="崩溃恢复现实：&#10;进程退出 → 循环栈帧消失 → 权威消失&#10;步内已完成的工具调用不可区分&#10;→ 整步重来（工具重复执行）或 run 报废" style="rounded=1;whiteSpace=wrap;fillColor=#FFF0F0;strokeColor=#CC0000;dashed=1;fontSize=12;" vertex="1" parent="lane-db">
          <mxGeometry x="40" y="430" width="300" height="90" as="geometry" />
        </mxCell>

        <!-- ======== 旧设计连线 ======== -->
        <mxCell id="be1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#B8860B;fontSize=11;" edge="1" parent="1" source="b-orch" target="b-callbacks">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="be2" value="一次调用启动整个多步循环" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#CC0000;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="b-callbacks" target="b-loop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="be3" value="回调回流（改参/审批/双写）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#CC0000;dashed=1;fontSize=11;exitX=0;exitY=0.75;entryX=1;entryY=0.5;" edge="1" parent="1" source="b-loop" target="b-capture">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="be4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="b-loop" target="b-provider">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="be5" value="OnStepCommitted 整步副本&#10;（部分失败窗口：写库≠推进循环）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#CC0000;dashed=1;fontSize=11;" edge="1" parent="1" source="b-loop" target="b-history">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="be6" value="DeferredToolApproval（单槽）→ 序列化" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#CC0000;dashed=1;fontSize=11;" edge="1" parent="1" source="b-approval-flow" target="b-approvals">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ======== 问题清单 ======== -->
        <mxCell id="b-problems" value="旧设计强加给 Memoh 的补偿（红色块 = 全部是补偿设计）&#10;&#10;1. 权威在库进程内存 → DB 只有回调副本，崩溃即权威消失（session_runs 自己注释了无 checkpoint 列）&#10;2. DeferredToolApproval 单槽位 → 并行工具审批被串行化；审批记录实为循环位置的手工序列化&#10;3. 进度止步于 Step → 步内 call 完成与否不可区分 → 重复执行或整 run 失败&#10;4. OnStepCommitted 双写 → 写库与循环推进之间双向部分失败窗口&#10;5. PrepareStep 即时构造请求 → 无冻结请求，恢复时按消息重建 ≠ 原请求，不可审计&#10;6. 恢复 = interruptedStepCapture 手工捕获流 + 带注解消息重进新循环 → 第二套控制流与 SDK 内循环并存&#10;7. 迁移结论（spec §11.3.5）：deferred 记录无法在线转换，只能排空 —— 数据形态不足以重建其声称的执行状态" style="rounded=1;whiteSpace=wrap;fillColor=#FFF8F8;strokeColor=#CC0000;fontSize=12;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="1060" height="230" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="after" name="新设计：Run ES + Runtime 权威">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1040" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ======== 泳道:Memoh(薄宿主) ======== -->
        <mxCell id="lane2-memoh" value="Memoh（薄宿主：组装,不再有第二套多步算法）" style="swimlane;horizontal=1;startSize=30;fillColor=#FFF7E6;strokeColor=#B8860B;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="360" height="620" as="geometry" />
        </mxCell>

        <mxCell id="a-planner" value="RequestPlanner（port 注入）&#10;session history / context / memory&#10;→ 冻结 sdk.Request" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8860B;fontSize=12;" vertex="1" parent="lane2-memoh">
          <mxGeometry x="30" y="50" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="a-ingress" value="response ingress（无 worker grant）&#10;approve / reject / answer&#10;→ Derive 出的稳定 CommandID" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8860B;fontSize=12;" vertex="1" parent="lane2-memoh">
          <mxGeometry x="30" y="160" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="a-queue" value="现有 queue（steer/follow-up 不重写）&#10;boundary 消费 → AcceptInput&#10;Prepare gate：事务内查 eligible steer" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8860B;fontSize=12;" vertex="1" parent="lane2-memoh">
          <mxGeometry x="30" y="270" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="a-material" value="materializer（outbox 消费者）&#10;事实 → history / usage / artifact&#10;source_event_id = run:rev:idx 幂等&#10;RunFinalized 后才 GC Run log" style="rounded=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=12;" vertex="1" parent="lane2-memoh">
          <mxGeometry x="30" y="380" width="300" height="90" as="geometry" />
        </mxCell>

        <mxCell id="a-scanner" value="recovery scanner&#10;lease 过期 → system command&#10;（经同一 Commit,不直写状态）" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8860B;fontSize=12;" vertex="1" parent="lane2-memoh">
          <mxGeometry x="30" y="500" width="300" height="80" as="geometry" />
        </mxCell>

        <!-- ======== 泳道:twilight agent/run ======== -->
        <mxCell id="lane2-run" value="twilight agent/run（唯一多步算法）" style="swimlane;horizontal=1;startSize=30;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="40" width="480" height="620" as="geometry" />
        </mxCell>

        <mxCell id="a-loop" value="run.Loop（无权威状态的解释器）&#10;每轮从 Load 开始；崩溃后新 Loop 原地继续&#10;模型 worker 随 ctx 取消 / 工具 worker 运行到底" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2E7D32;fontSize=12;" vertex="1" parent="lane2-run">
          <mxGeometry x="30" y="50" width="420" height="80" as="geometry" />
        </mxCell>

        <mxCell id="a-machine" value="Machine（纯函数）&#10;Decide(state, command) → []Fact  ← 全部决策,提交时一次&#10;Evolve(state, fact) → state  ← 机械折叠,永久冻结&#10;Next(state) → Effect" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2E7D32;fontSize=12;align=left;spacing=8;" vertex="1" parent="lane2-run">
          <mxGeometry x="30" y="160" width="420" height="100" as="geometry" />
        </mxCell>

        <mxCell id="a-evaluate" value="EvaluateCommit（单实现,两个 runtime 共用）&#10;幂等（CommandID+digest）→ AlreadyApplied 返原事件组&#10;类别化 rebase（Prepare 硬 CAS,其余按前置条件重验）&#10;grant 校验 → start 铸造 / completion 消费" style="rounded=1;whiteSpace=wrap;fillColor=#DFF0D8;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="lane2-run">
          <mxGeometry x="30" y="290" width="420" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a-state-model" value="Step / ToolCall 状态机&#10;ModelStep: Prepared→Executing（冻结请求,recovery 重试）&#10;ToolCall: Pending→Executing→Completed/Failed&#10;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;↘ Waiting(每个 Call 独立 ResponseRequest)&#10;并行审批各自路由；Unknown → RunFailed（不猜测外部 effect）" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2E7D32;fontSize=12;align=left;spacing=8;" vertex="1" parent="lane2-run">
          <mxGeometry x="30" y="430" width="420" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a-conformance" value="runtimetest.RunConformance：durable adapter 的验收门槛（11 项）" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2E7D32;dashed=1;fontSize=12;" vertex="1" parent="lane2-run">
          <mxGeometry x="30" y="560" width="420" height="40" as="geometry" />
        </mxCell>

        <!-- ======== 泳道:PostgreSQL(权威) ======== -->
        <mxCell id="lane2-db" value="PostgreSQL（执行权威所在地,同一事务）" style="swimlane;horizontal=1;startSize=30;fillColor=#F0F4FF;strokeColor=#4169AA;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="40" width="480" height="620" as="geometry" />
        </mxCell>

        <mxCell id="a-header" value="agent_run_header（Revision 0,immutable）&#10;最小初始状态 + digest + causation" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4169AA;fontSize=12;" vertex="1" parent="lane2-db">
          <mxGeometry x="30" y="50" width="420" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a-log" value="agent_run_transition（source of truth）&#10;PK (run_id, revision)——CAS 内建于 INSERT&#10;UNIQUE (run_id, command_id)——幂等索引&#10;一行 = 一次 accepted command 的完整事件组" style="rounded=1;whiteSpace=wrap;fillColor=#D6E4FF;strokeColor=#4169AA;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="lane2-db">
          <mxGeometry x="30" y="140" width="420" height="100" as="geometry" />
        </mxCell>

        <mxCell id="a-proj" value="agent_run_state（projection,可重建）&#10;state = fold(Evolve, header, log)&#10;watermark：尾部完整性见证,重建不清除&#10;分歧且日志完整 → 自动重建；日志低于水位 → halt" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4169AA;fontSize=12;align=left;spacing=8;" vertex="1" parent="lane2-db">
          <mxGeometry x="30" y="270" width="420" height="100" as="geometry" />
        </mxCell>

        <mxCell id="a-lease" value="agent_run_lease（Memoh 私有 control-plane）&#10;grant_token / owner / fence —— 不进事件,不进状态" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4169AA;fontSize=12;" vertex="1" parent="lane2-db">
          <mxGeometry x="30" y="400" width="420" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a-outbox" value="materialization outbox（与 transition 同事务）&#10;history / usage / artifact 投影,source_event_id 幂等" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4169AA;fontSize=12;" vertex="1" parent="lane2-db">
          <mxGeometry x="30" y="490" width="420" height="60" as="geometry" />
        </mxCell>

        <!-- ======== 新设计连线 ======== -->
        <mxCell id="ae1" value="Plan → PrepareModelRequest（冻结）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#B8860B;fontSize=11;" edge="1" parent="1" source="a-planner" target="a-loop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae2" value="AgentCommand" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2E7D32;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="a-loop" target="a-evaluate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae3" value="Decide + Evolve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2E7D32;fontSize=11;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="a-evaluate" target="a-machine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae4" value="原子提交：TransitionRecord + projection&#10;+ watermark + lease + outbox（一个事务）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#4169AA;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="a-evaluate" target="a-log">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae5" value="独立 ingress 命令（不伪装 Loop）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#B8860B;dashed=1;fontSize=11;" edge="1" parent="1" source="a-ingress" target="a-evaluate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae6" value="outbox 事实驱动（非状态差分）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2E7D32;dashed=1;fontSize=11;" edge="1" parent="1" source="a-outbox" target="a-material">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ======== 对比要点 ======== -->
        <mxCell id="a-wins" value="错位的纠正（每条对应左图一个红色补偿）&#10;&#10;1. 权威移到 Runtime 事务（header+log）→ Loop 无权威状态,崩溃后新 Loop 从 Load 原地继续（对应旧 #1）&#10;2. 每个 Waiting Call 独立 ResponseRequest/ResponseID → 并行审批各自路由（对应旧 #2 单槽位）&#10;3. 逐 Call 状态 + start barrier + grant → 步内进度精确恢复,结果未知按 Unknown 收束（对应旧 #3）&#10;4. CommandID+digest effectively-once,TransitionRecord 与投影同事务 → 双写窗口消除（对应旧 #4）&#10;5. PrepareModelRequest 冻结 + 硬 CAS → 恢复重试同一请求,&quot;模型看到了什么&quot;可审计（对应旧 #5）&#10;6. 审批经同一 Commit 语义回流 → 第二套控制流消失,NativeAgentLoop 收敛为薄宿主（对应旧 #6）&#10;7. RunHeader + TransitionRecord log 可导出/验证/重放 → 从&quot;无法迁移&quot;到&quot;协议内置迁移&quot;（对应旧 #7）" style="rounded=1;whiteSpace=wrap;fillColor=#F1F8F1;strokeColor=#2E7D32;fontSize=12;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="1400" height="230" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
